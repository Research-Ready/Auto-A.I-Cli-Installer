# WARNING: Copy this file to api_keys.env and fill in your keys.
# NEVER commit api_keys.env — it is in .gitignore.

# ── Anthropic / Claude ────────────────────────────────────────────
# Get at: console.anthropic.com → API Keys
# Note: claude.ai Pro subscription does NOT include API credits — this is separate billing
ANTHROPIC_API_KEY=

# ── OpenAI / Codex ───────────────────────────────────────────────
# Get at: platform.openai.com → API Keys
# Note: ChatGPT Plus/Pro subscription does NOT include API credits — this is separate billing
OPENAI_API_KEY=

# ── Google / Gemini ──────────────────────────────────────────────
# Get at: aistudio.google.com → Get API Key
# FREE TIER: 1,000 requests/day with Gemini 2.5 Pro/Flash — no credit card needed
GOOGLE_API_KEY=

# ── OpenRouter (also unlocks permanently-free models) ────────────
# Get at: openrouter.ai → Keys
# FREE TIER: 50 req/day free; many models are permanently free (Llama, Mistral, etc.)
OPENROUTER_API_KEY=

# ── Groq ─────────────────────────────────────────────────────────
# Get at: console.groq.com → API Keys
# FREE TIER: ~8,000 tokens/min — fastest cloud inference (LPU hardware)
GROQ_API_KEY=

# ── Cerebras ─────────────────────────────────────────────────────
# Get at: cloud.cerebras.ai → API Keys
# FREE TIER: Developer tier available — 2nd fastest cloud inference
CEREBRAS_API_KEY=

# ── SambaNova ────────────────────────────────────────────────────
# Get at: cloud.sambanova.ai → API Keys
# FREE TIER: Developer tier available
SAMBANOVA_API_KEY=

# ── Fireworks AI ─────────────────────────────────────────────────
# Get at: fireworks.ai → API Keys
# FREE TIER: 10 RPM free without credit card
FIREWORKS_API_KEY=

# ── DeepSeek ─────────────────────────────────────────────────────
# Get at: platform.deepseek.com → API Keys
# NEAR-FREE: ~$0.001 per 1M tokens — cheapest capable API
DEEPSEEK_API_KEY=

# ── Mistral ──────────────────────────────────────────────────────
# Get at: console.mistral.ai → API Keys
# FREE TIER: Available on La Plateforme
MISTRAL_API_KEY=

# ── Hugging Face ─────────────────────────────────────────────────
# Get at: huggingface.co → Settings → Access Tokens
# FREE TIER: Free inference API for thousands of models
HUGGINGFACE_TOKEN=

# ── Cohere ───────────────────────────────────────────────────────
# Get at: dashboard.cohere.com → API Keys
# FREE TIER: Trial tier available
COHERE_API_KEY=

# ── Perplexity ───────────────────────────────────────────────────
# Get at: perplexity.ai → Settings → API
PERPLEXITY_API_KEY=

# ── GitHub (Copilot CLI) ─────────────────────────────────────────
# Get at: github.com → Settings → Developer Settings → Personal Access Tokens
# Requires GitHub Copilot subscription
GITHUB_TOKEN=

# ── Cloudflare Workers AI ────────────────────────────────────────
# Get at: dash.cloudflare.com → Workers → AI
# FREE TIER: Available
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ── AWS Bedrock ──────────────────────────────────────────────────
# Get at: aws.amazon.com → IAM → Access Keys
# Pay per use — no free tier for Bedrock models
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
